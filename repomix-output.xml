		font-size: 0.875rem;
	}
	.proof-band {
		display: grid;
		grid-template-columns: 0.95fr 1.05fr;
		overflow: hidden;
		border-radius: var(--radius-2xl);
		background: var(--color-forest-800);
	}
	.proof-copy {
		padding: 56px;
		color: var(--color-stone-50);
	}
	.proof-copy .eyebrow {
		color: var(--color-gold-200);
	}
	.proof-copy p {
		margin-top: 22px;
		color: var(--color-stone-200);
	}
	.proof-points {
		display: grid;
		gap: 16px;
		margin-top: 32px;
	}
	.proof-points div {
		display: grid;
		grid-template-columns: 24px 1fr;
		gap: 10px;
		font-size: 0.875rem;
	}
	.proof-points svg {
		color: var(--color-gold-200);
	}
	.proof-image {
		position: relative;
		min-height: 420px;
	}
	.image-evidence {
		position: absolute;
		right: 20px;
		bottom: 20px;
		left: 20px;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		border: 1px solid rgb(246 248 238 / 0.18);
		border-radius: var(--radius-md);
		padding: 13px 15px;
		background: rgb(23 42 31 / 0.86);
		color: var(--color-stone-50);
	}
	.image-evidence p {
		font-family: ui-monospace, monospace;
		font-size: 0.61rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.image-evidence span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--color-gold-200);
		font-size: 0.68rem;
	}
	.care-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 64px;
		align-items: center;
	}
	.care-image {
		overflow: hidden;
		border-radius: var(--radius-xl);
		aspect-ratio: 3 / 2;
	}
	.section-copy {
		margin-top: 20px;
	}
	.section-cta {
		margin-top: 28px;
	}
	.review-list {
		display: grid;
		margin-top: 28px;
		border-top: 1px solid var(--line);
	}
	.review-list div {
		display: grid;
		grid-template-columns: 72px 1fr;
		gap: 16px;
		border-bottom: 1px solid var(--line);
		padding: 16px 0;
	}
	.review-list span {
		color: var(--color-gold-700);
		font-family: ui-monospace, monospace;
		font-size: 0.72rem;
	}
	.review-list p {
		color: var(--ink-soft);
		font-size: 0.9375rem;
	}
	.faq {
		width: min(100%, 760px);
		margin: 48px auto 0;
	}
	.faq details {
		border-bottom: 1px solid var(--line);
	}
	.faq summary {
		display: flex;
		min-height: 76px;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		list-style: none;
		cursor: pointer;
		font-family: var(--font-fraunces), serif;
		font-size: 1.25rem;
		font-weight: 600;
	}
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq details[open] summary svg {
		transform: rotate(45deg);
	}
	.faq details p {
		padding: 0 32px 24px 0;
		color: var(--ink-soft);
		font-size: 0.9375rem;
	}
	.contact-band {
		padding: 96px 0;
		background: var(--surface-chip);
		color: var(--ink);
	}
	.contact-grid {
		display: grid;
		grid-template-columns: 0.78fr 1.22fr;
		gap: 80px;
		align-items: start;
	}
	.contact-band .body-lg {
		color: var(--ink-soft);
	}
	.contact-facts {
		display: grid;
		gap: 14px;
		margin-top: 32px;
		color: var(--ink-soft);
		font-size: 0.875rem;
	}
	.contact-facts div {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.contact-form {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		border-radius: var(--radius-xl);
		padding: 32px;
		background: #fff;
		box-shadow: var(--shadow-sm);
	}
	.field {
		display: grid;
		gap: 8px;
	}
	.field--full {
		grid-column: 1 / -1;
	}
	.field label {
		color: var(--color-forest-950);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.field input,
	.field textarea,
	.field select {
		width: 100%;
		border: 1px solid var(--color-stone-600);
		border-radius: var(--radius-sm);
		background: #fff;
		color: var(--color-forest-950);
		padding: 12px 14px;
		font-size: 0.9375rem;
	}
	.field textarea {
		min-height: 112px;
		resize: vertical;
	}
	.form-note {
		grid-column: 1 / -1;
		color: var(--color-stone-800);
		font-size: 0.75rem;
	}
	.form-status {
		grid-column: 1 / -1;
		min-height: 1.25rem;
		font-size: 0.875rem;
		font-weight: 600;
	}
	.form-status--success {
		color: var(--color-forest-700);
	}
	.form-status--error {
		color: #a32929;
	}
	.contact-form button:disabled {
		cursor: wait;
		opacity: 0.7;
	}
	.footer {
		padding: 56px 0 28px;
		background: var(--surface-band);
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr repeat(3, 0.7fr);
		gap: 36px;
	}
	.footer h4 {
		margin: 0 0 12px;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.footer a,
	.footer p {
		display: block;
		margin: 7px 0;
		color: var(--ink-soft);
		font-size: 0.875rem;
	}
	.footer .footer-intro {
		max-width: 27ch;
		margin-top: 14px;
	}
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		gap: 24px;
		margin-top: 48px;
		border-top: 1px solid var(--line);
		padding-top: 20px;
		color: var(--ink-muted);
		font-size: 0.75rem;
	}
	.reveal {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 560ms cubic-bezier(0.16, 1, 0.3, 1),
			transform 560ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.service-hero {
		padding: 136px 0 88px;
		background:
			radial-gradient(
				circle at 88% 12%,
				color-mix(in srgb, var(--color-aqua-200) 62%, transparent),
				transparent 30%
			),
			var(--surface);
	}
	.service-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(310px, 0.72fr);
		gap: 62px;
		align-items: center;
	}
	.service-hero .body-lg {
		margin-top: 24px;
	}
	.service-back {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		margin-bottom: 46px;
		color: var(--ink-muted);
		font-family: ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.evidence-panel {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-2xl);
		padding: 32px;
		background: var(--surface-raised);
		box-shadow: var(--shadow-md);
	}
	.evidence-panel::before {
		position: absolute;
		top: -70px;
		right: -64px;
		width: 220px;
		height: 220px;
		border-radius: 50%;
		background: var(--color-aqua-200);
		content: "";
		opacity: 0.65;
	}
	.evidence-panel > * {
		position: relative;
		z-index: 1;
	}
	.evidence-panel h2 {
		max-width: 16ch;
		font-size: clamp(1.45rem, 2.3vw, 2rem);
	}
	.evidence-map {
		position: relative;
		display: grid;
		gap: 17px;
		margin-top: 30px;
		padding-left: 17px;
	}
	.evidence-map::before {
		position: absolute;
		top: 9px;
		bottom: 9px;
		left: 4px;
		width: 1px;
		background: var(--color-forest-400);
		content: "";
	}
	.evidence-node {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 9px;
		align-items: center;
	}
	.evidence-node > span {
		position: absolute;
		left: -17px;
		width: 10px;
		height: 10px;
		border: 2px solid var(--surface-raised);
		border-radius: 50%;
		background: var(--color-aqua-300);
	}
	.evidence-node b {
		font-size: 0.83rem;
	}
	.evidence-node em {
		color: var(--ink-muted);
		font-family: ui-monospace, monospace;
		font-size: 0.58rem;
		font-style: normal;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.evidence-outcome {
		display: grid;
		grid-template-columns: 10px 1fr auto;
		gap: 10px;
		align-items: center;
		margin-top: 26px;
		border-top: 1px solid var(--line);
		padding-top: 18px;
		font-size: 0.78rem;
		font-weight: 700;
	}
	.evidence-outcome > span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
	}
	.service-hero-grid--customisation .evidence-panel {
		border-color: rgb(246 248 238 / 0.16);
		background: var(--surface-invert);
		color: var(--ink-invert);
	}
	.service-hero-grid--customisation .evidence-panel::before {
		background: var(--color-gold-300);
	}
	.service-hero-grid--customisation .evidence-node em {
		color: var(--color-stone-300);
	}
	.service-section-heading {
		display: grid;
		gap: 18px;
	}
	.service-signal-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px 28px;
		margin-top: 42px;
	}
	.service-signal {
		position: relative;
		min-height: 190px;
		border-top: 1px solid var(--line);
		padding: 22px 0 12px;
	}
	.service-signal::before {
		position: absolute;
		top: -5px;
		left: 0;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--color-aqua-300);
		content: "";
	}
	.service-signal > span {
		color: var(--color-aqua-800);
		font-family: ui-monospace, monospace;
		font-size: 0.68rem;
		font-weight: 600;
	}
	.service-signal h3 {
		margin-top: 18px;
		font-size: 1.18rem;
	}
	.service-signal p {
		margin-top: 10px;
		color: var(--ink-soft);
		font-size: 0.92rem;
	}
	.service-method-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
		margin-top: 44px;
	}
	.service-method-grid article {
		border-top: 1px solid var(--line);
		padding-top: 22px;
	}
	.service-method-icon {
		width: 46px;
		height: 46px;
		margin-top: 0;
	}
	.service-method-grid h3 {
		margin-top: 20px;
		font-size: 1.35rem;
	}
	.service-method-grid p {
		margin-top: 10px;
		color: var(--ink-soft);
		font-size: 0.94rem;
	}
	.diagnostic-panel {
		display: grid;
		grid-template-columns: 1fr 0.8fr;
		gap: 48px;
		align-items: center;
		border-radius: var(--radius-2xl);
		padding: 52px;
		background: var(--surface-invert);
		color: var(--ink-invert);
	}
	.diagnostic-panel .eyebrow {
		color: var(--color-gold-200);
	}
	.diagnostic-panel > div:first-child > p:not(.eyebrow) {
		margin-top: 20px;
		color: var(--color-stone-200);
	}
	.diagnostic-panel .btn {
		margin-top: 28px;
	}
	.diagnostic-rows {
		display: grid;
		gap: 14px;
	}
	.diagnostic-rows p {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		border-bottom: 1px solid rgb(246 248 238 / 0.25);
		padding-bottom: 13px;
		font-size: 0.86rem;
	}
	.diagnostic-rows span {
		color: var(--color-stone-300);
		font-family: ui-monospace, monospace;
		font-size: 0.68rem;
		text-transform: uppercase;
	}
	.diagnostic-rows b {
		text-align: right;
	}
	.service-end {
		padding: 96px 0;
		background: var(--surface-chip);
		color: var(--color-forest-950);
	}
	.service-end .body-lg {
		margin-top: 20px;
		color: var(--color-stone-800);
	}
	.service-end .btn {
		margin-top: 30px;
	}
}

@media (max-width: 1024px) {
	.container {
		width: min(100% - 64px, 1200px);
	}
	.hero-grid {
		grid-template-columns: 1fr 0.78fr;
		gap: 40px;
	}
	.hero-art {
		height: 470px;
		min-height: 0;
	}
	.pain-grid {
		grid-template-columns: repeat(3, 1fr);
	}
	.offers {
		gap: 16px;
	}
	.offer {
		min-height: 620px;
		padding: 26px;
	}
}

@media (max-width: 768px) {
	.container {
		width: min(100% - 48px, 1200px);
	}
	.section {
		padding: 72px 0;
	}
	.section--tight {
		padding: 56px 0;
	}
	.nav {
		height: 64px;
	}
	.nav-links,
	.nav-actions {
		display: none;
	}
	.menu-toggle {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--ink);
	}
	.service-mobile-cta {
		display: inline-flex;
		border-radius: 999px;
		padding: 7px 14px;
		background: var(--accent);
		color: var(--accent-ink);
		font-size: 0.78rem;
		font-weight: 700;
	}
	.mobile-menu {
		position: fixed;
		z-index: 49;
		inset: 0;
		display: grid;
		align-content: center;
		gap: 20px;
		padding: 96px 32px 40px;
		background: var(--surface);
		opacity: 0;
		pointer-events: none;
		transition: opacity 200ms ease;
	}
	.mobile-menu.is-open {
		opacity: 1;
		pointer-events: auto;
	}
	.mobile-menu a {
		padding: 8px 0;
		font-family: var(--font-fraunces), serif;
		font-size: clamp(2rem, 9vw, 3.25rem);
		font-weight: 600;
	}
	.mobile-menu .theme-switcher,
	.mobile-menu .btn {
		width: fit-content;
		margin-top: 12px;
	}
	.hero {
		min-height: auto;
		padding: 128px 0 68px;
	}
	.hero-grid,
	.section-heading--split,
	.decision-grid,
	.care-grid,
	.contact-grid,
	.service-hero-grid,
	.diagnostic-panel {
		grid-template-columns: 1fr;
		gap: 38px;
	}
	.hero-art {
		height: 460px;
	}
	.hero-photo-wrap {
		inset: 16px 0 0 20px;
	}
	.operating-map {
		top: 54px;
		left: -12px;
	}
	.signal-card {
		right: -12px;
		bottom: 8px;
	}
	.pain-grid,
	.footer-grid {
		grid-template-columns: repeat(2, 1fr);
	}
	.path-grid,
	.offers,
	.service-signal-grid,
	.service-method-grid {
		grid-template-columns: 1fr;
	}
	.offer {
		min-height: auto;
		padding: 32px;
	}
	.steps {
		grid-template-columns: 1fr;
		gap: 10px;
	}
	.step {
		padding: 0 0 22px 52px;
	}
	.step::before {
		top: 0;
		right: auto;
		bottom: 0;
		left: 15px;
		width: 1px;
		height: auto;
	}
	.proof-band {
		grid-template-columns: 1fr;
	}
	.proof-copy {
		padding: 40px 32px;
	}
	.proof-image {
		min-height: 300px;
	}
	.contact-form {
		grid-template-columns: 1fr;
		padding: 24px;
	}
	.field--full {
		grid-column: auto;
	}
	.service-hero {
		padding: 88px 0 68px;
	}
	.diagnostic-panel {
		padding: 40px 32px;
	}
}

@media (max-width: 480px) {
	.container {
		width: min(100% - 40px, 1200px);
	}
	.display-xl {
		font-size: clamp(2.75rem, 15vw, 3.7rem);
	}
	.hero-actions {
		align-items: stretch;
		flex-direction: column;
	}
	.hero-actions .btn {
		width: 100%;
	}
	.hero-art {
		height: 380px;
	}
	.operating-map {
		top: 48px;
		width: 210px;
		padding: 13px;
	}
	.signal-card {
		width: 88%;
		padding: 16px;
	}
	.pain-grid,
	.footer-grid {
		grid-template-columns: 1fr;
	}
	.decision-statement,
	.process-wrap,
	.diagnostic-panel {
		padding: 32px 24px;
	}
	.offer {
		padding: 28px 24px;
	}
	.footer-bottom {
		flex-direction: column;
		gap: 6px;
	}
}

@media (prefers-reduced-motion: reduce) {
	html {
		scroll-behavior: auto;
	}
	*,
	*::before,
	*::after {
		animation-duration: 0.01ms !important;
		animation-iteration-count: 1 !important;
		transition-duration: 0.01ms !important;
	}
	.reveal {
		opacity: 1;
		transform: none;
	}
}
