  --cta-hover: var(--forest-900);
  --cta-ink: var(--stone-50);
  --accent-fill: var(--gold-300);
  --accent-ink: var(--forest-950);
  --highlight: var(--chartreuse-300);
  --focus-ring: var(--forest-800);
  --focus-on-forest: var(--gold-300);
  --shadow-sm: 0 2px 4px rgb(23 42 31 / 0.05), 0 4px 12px rgb(23 42 31 / 0.05);
  --shadow-md: 0 4px 8px rgb(23 42 31 / 0.06), 0 12px 28px rgb(23 42 31 / 0.07);

  --font-display: "Fraunces", "Iowan Old Style", Georgia, serif;
  --font-body: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-ui: var(--font-body);
  --font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Consolas, monospace;

  /* 霞鹜文楷 — self-hosted under /fonts/lxgw-wenkai/ (in index.html) */
  --font-cjk: "LXGW WenKai", "霞鹜文楷", serif;

  --pad-x: clamp(1.25rem, 5vw, 2.5rem);
  --radius-xs: 6px;
  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --radius-2xl: 40px;
  --duration-fast: 200ms;
  --duration-base: 320ms;
  --ease-organic: cubic-bezier(0.34, 0.9, 0.32, 1);
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: var(--forest-950);
    --surface: var(--forest-900);
    --surface-soft: rgb(237 240 228 / 0.07);
    --ink: var(--stone-100);
    --ink-dim: var(--stone-300);
    --ink-muted: var(--stone-400);
    --line: rgb(237 240 228 / 0.1);
    --control-line: rgb(237 240 228 / 0.3);
    --link: var(--aqua-300);
    --cta: var(--forest-300);
    --cta-hover: var(--forest-200);
    --cta-ink: var(--forest-950);
    --highlight: var(--chartreuse-400);
    --focus-ring: var(--gold-300);
    --shadow-sm: 0 2px 6px rgb(37 38 29 / 0.4);
    --shadow-md: 0 6px 20px rgb(37 38 29 / 0.45);
  }
}

/* Chinese locale: WenKai for UI copy; the Latin name keeps Fraunces via .name. */
html[lang="zh-CN"] {
  --font-body: var(--font-cjk);
  --font-ui: var(--font-cjk);
}
