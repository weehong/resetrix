// Prisma schema. Docs: https://pris.ly/d/prisma-schema
// After editing, run `npm run db:generate` (client) and `npm run db:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Local projection of an Auth0 User. `auth0Sub` is the stable identity key
/// (Auth0 `sub`); email/name sync from token claims on each authenticated call.
model User {
  id        String   @id @default(cuid())
  auth0Sub  String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
