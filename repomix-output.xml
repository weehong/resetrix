# Production-oriented Compose stack. Inject secrets via the host environment
# (or an env_file); do not commit real passwords. Example:
#   export POSTGRES_PASSWORD=...
#   export DATABASE_URL=postgresql://postgres:...@db:5432/resetrix?schema=public
