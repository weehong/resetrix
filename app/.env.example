VITE_APP_ENVIRONMENT="development"

# HTTP API origin the SPA calls with Bearer access tokens.
VITE_API_URL="http://localhost:3000"

# Auth0 SPA gate — see docs/auth0-operator-setup.md for how to obtain these.
# Bare tenant domain, without protocol or path (e.g. your-tenant.us.auth0.com).
VITE_AUTH0_DOMAIN=""
# Client ID of the Auth0 "Single Page Application".
VITE_AUTH0_CLIENT_ID=""
# Identifier of the Auth0 API (audience) the SPA requests access tokens for.
VITE_AUTH0_AUDIENCE=""
# Optional redirect URI override; defaults to "<origin>/callback" when unset.
# VITE_AUTH0_CALLBACK_URL="http://localhost:5173/callback"
