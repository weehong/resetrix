  --shadow-xl: 0 24px 64px rgb(0 0 0 / .55);
}

@theme inline {
  --color-surface:        var(--surface-base);
  --color-surface-raised: var(--surface-raised);
  --color-surface-band:   var(--surface-band);
  --color-surface-chip:   var(--surface-chip);
